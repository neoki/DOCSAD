generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum EstadoChecklist {
  COMPLETADO
  PENDIENTE
  NO_APLICA
}

enum Urgencia {
  CRITICA
  ALTA
  MEDIA
  BAJA
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())

  @@map("users")
}

model Comunidad {
  id        String     @id @default(cuid())
  codigo    String     @unique
  idPersona String?
  nombre    String
  nif       String
  direccion String
  cp        String     @default("")
  pisos     Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  sharePointSiteId  String?
  sharePointDriveId String?
  sharePointFolderId String?
  sharePointFolderName String?
  sharePointMatchMethod String?
  sharePointMatchScore Int?

  operativa          Operativa?
  checklists         Checklist[]
  documentos         Documento[]
  alertas            Alerta[]
  fileCache          FileCache[]
  notas              Nota[]
  documentExpiries   DocumentExpiry[]
  routingCandidates  RoutingCandidate[]

  @@map("comunidades")
}

model Operativa {
  id          String    @id @default(cuid())
  comunidadId String    @unique
  comunidad   Comunidad @relation(fields: [comunidadId], references: [id], onDelete: Cascade)

  usaAgreGasfincas            Boolean @default(false)
  somosCorredorSeguro         Boolean @default(false)
  corredorSeguroNombre        String?
  numeroPolizaSeguro          String?
  usaNuevoSistemaIncidencias  Boolean @default(false)
  tieneAppTuComunidad         Boolean @default(false)
  tienePortero                Boolean @default(false)
  tieneConserje               Boolean @default(false)
  tieneGarajista              Boolean @default(false)
  tieneLimpiadora             Boolean @default(false)
  tieneOtroPersonal           Boolean @default(false)
  descripcionOtroPersonal     String?
  tieneVideovigilancia        Boolean @default(false)
  actuaComoArrendadora        Boolean @default(false)
  activoArrendadoDescripcion  String?
  gestionaConsumos            Boolean @default(false)
  empresaGestionConsumos      String?
  gestionaPermisosGasoleo     Boolean @default(false)
  reformaFontaneria           Boolean @default(false)
  fechaReformaFontaneria      DateTime?
  reformaSaneamiento          Boolean @default(false)
  fechaReformaSaneamiento     DateTime?
  reformaElectricidad         Boolean @default(false)
  fechaReformaElectricidad    DateTime?
  obligadaITE                 Boolean @default(false)
  fechaProximaITE             DateTime?

  @@map("operativas")
}

model Checklist {
  id           String          @id @default(cuid())
  comunidadId  String
  comunidad    Comunidad       @relation(fields: [comunidadId], references: [id], onDelete: Cascade)
  docTypeId    String
  estado       EstadoChecklist @default(PENDIENTE)
  fecha        DateTime?
  observaciones String         @default("")
  justificacion String         @default("")

  @@unique([comunidadId, docTypeId])
  @@map("checklists")
}

model Documento {
  id          String    @id @default(cuid())
  comunidadId String
  comunidad   Comunidad @relation(fields: [comunidadId], references: [id], onDelete: Cascade)
  docTypeId   String
  nombre      String
  rutaArchivo String?
  sizeBytes   Int       @default(0)
  aiConfianza Int?
  uploadedAt  DateTime  @default(now())

  @@map("documentos")
}

model Alerta {
  id          String    @id @default(cuid())
  comunidadId String
  comunidad   Comunidad @relation(fields: [comunidadId], references: [id], onDelete: Cascade)
  tipo        String
  urgencia    Urgencia
  titulo      String
  descripcion String
  descartada  Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@map("alertas")
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @default("")
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model FileCache {
  id              String   @id @default(cuid())
  comunidadId     String?
  comunidad       Comunidad? @relation(fields: [comunidadId], references: [id], onDelete: SetNull)
  sharePointItemId String   @unique
  driveId         String
  name            String
  path            String
  subfolder       String?
  sizeBytes       Int      @default(0)
  mimeType        String?
  isFolder        Boolean  @default(false)
  sharePointModified DateTime?
  sharePointHash  String?
  webUrl          String?
  lastSyncedAt    DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([comunidadId])
  @@index([path])
  @@map("file_cache")
}

model SyncLog {
  id          String   @id @default(cuid())
  operation   String
  status      String   @default("success")
  comunidadId String?
  fileName    String?
  filePath    String?
  sourceItemId String?
  destItemId  String?
  details     String?
  error       String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([comunidadId])
  @@map("sync_logs")
}

model SyncState {
  id            String   @id @default(cuid())
  key           String   @unique
  value         String   @default("")
  updatedAt     DateTime @updatedAt

  @@map("sync_state")
}

model Nota {
  id          String    @id @default(cuid())
  comunidadId String
  comunidad   Comunidad @relation(fields: [comunidadId], references: [id], onDelete: Cascade)
  texto       String
  autor       String    @default("admin")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([comunidadId])
  @@map("notas")
}

model Favorite {
  id          String    @id @default(cuid())
  userId      String
  comunidadId String
  createdAt   DateTime  @default(now())

  @@unique([userId, comunidadId])
  @@index([userId])
  @@map("favorites")
}

model DocumentExpiry {
  id               String    @id @default(cuid())
  sharePointItemId String    @unique
  comunidadId      String
  comunidad        Comunidad @relation(fields: [comunidadId], references: [id], onDelete: Cascade)
  fileName         String
  label            String
  expiresAt        DateTime
  notificado       Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([comunidadId])
  @@index([expiresAt])
  @@map("document_expiry")
}

model AuditLog {
  id          String    @id @default(cuid())
  userId      String?
  userEmail   String?
  action      String
  entity      String
  entityId    String?
  details     String?
  ipAddress   String?
  createdAt   DateTime  @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([entity])
  @@map("audit_logs")
}

model RoutingCandidate {
  id               String     @id @default(cuid())
  sharePointItemId String     @unique
  fileName         String
  filePath         String?
  communityCode    String?
  comunidadId      String?
  comunidad        Comunidad? @relation(fields: [comunidadId], references: [id], onDelete: SetNull)
  subfolder        String     @default("11_Otros")
  confidence       String     @default("none")
  reason           String     @default("")
  status           String     @default("pending")
  driveId          String?
  confirmedAt      DateTime?
  confirmedBy      String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([comunidadId])
  @@index([status])
  @@index([communityCode])
  @@map("routing_candidates")
}
